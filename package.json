{
  "name": "sync-label",
  "version": "0.0.1",
  "description": "基于 Three.js 的高性能 3D 标注库，支持点、多边形和文字的实例化渲染与自定义响应式系统",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "pnpm build",
    "prepare": "husky install",
    "build": "vite build --mode lib",
    "demo": "vite example",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "files": ["dist"],
  "keywords": ["3d", "annotation", "WebGL", "Three.js", "label", "instanced"],
  "author": "YUNIUN",
  "license": "Mozilla Public License 2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YUNIUN/sync-label.git"
  },
  "bugs": {
    "url": "https://github.com/YUNIUN/sync-label/issues"
  },
  "homepage": "https://github.com/YUNIUN/sync-label",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "dependencies": {
    "lodash-es": "^4.18.1",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/three": "^0.184.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.10",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^5.0.1"
  }
}
